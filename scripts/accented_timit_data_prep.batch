#!/bin/bash
#SBATCH -A bbjs-dtai-gh
#SBATCH -p ghx4-interactive
#SBATCH -J accented_timit_prep
#SBATCH -N 1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=1
#SBATCH -c 16
#SBATCH --mem=64G
#SBATCH -t 2:00:00
#SBATCH -o exp/slurm_logs/%j.out
#SBATCH -e exp/slurm_logs/%j.out

set -euo pipefail

cd /work/nvme/bbjs/sbharadwaj/powsm/xeuspr
mkdir -p exp/slurm_logs exp/data

source ~/.bashrc
conda deactivate || true
source setup_uv.sh .venv_dai requirements-dai.txt
echo "Environment setup complete."

DOWNLOADS=/work/nvme/bbjs/sbharadwaj/powsm/xeuspr/exp/downloads

declare -A OUT_DIR=(
    [L1ENGsimple]=exp/data/global-timit-l1eng-simple-segment
    [L2ENGsimple]=exp/data/global-timit-l2eng-simple-segment
    [L1ENGtreebank]=exp/data/global-timit-l1eng-tbnk-segment
    [L2ENGtreebank]=exp/data/global-timit-l2eng-tbnk-segment
    [THA]=exp/data/global-timit-tha-segment
)

for subset in L1ENGsimple L2ENGsimple L1ENGtreebank L2ENGtreebank THA; do
    out=${OUT_DIR[$subset]}
    echo "=== ${subset} → ${out} ==="
    python -m src.recipe.segmentation.local.accented_timit_data_prep \
        --subset "${subset}" \
        --downloads_root "${DOWNLOADS}" \
        --output_dir "${out}"
done

echo "All sub-corpora prepared."
