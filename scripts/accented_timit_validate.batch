#!/bin/bash
#SBATCH -A bbjs-dtai-gh
#SBATCH -p ghx4-interactive
#SBATCH -J accented_timit_val
#SBATCH -N 1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=1
#SBATCH -c 4
#SBATCH --mem=32G
#SBATCH -t 0:15:00
#SBATCH -o exp/slurm_logs/%j.out
#SBATCH -e exp/slurm_logs/%j.out

set -euo pipefail

cd /work/nvme/bbjs/sbharadwaj/powsm/xeuspr
mkdir -p exp/slurm_logs

source ~/.bashrc
conda deactivate || true
source setup_uv.sh .venv_dai requirements-dai.txt
echo "Environment setup complete."

python - <<'PY'
from datasets import load_from_disk

DIRS = [
    "exp/data/global-timit-l1eng-simple-segment",
    "exp/data/global-timit-l2eng-simple-segment",
    "exp/data/global-timit-l1eng-tbnk-segment",
    "exp/data/global-timit-l2eng-tbnk-segment",
    "exp/data/global-timit-tha-segment",
]
for d in DIRS:
    ds = load_from_disk(d)["test"]
    row = ds[0]
    assert row["audio"]["sampling_rate"] == 16000, d
    n = len(row["phones"])
    assert n > 0 and len(row["phone_starts"]) == n and len(row["phone_ends"]) == n, d
    assert row["speaker_id"] and row["utt_id"], d
    speakers = sorted(set(ds["speaker_id"]))
    print(f"{d}\n  rows={len(ds)} unique_speakers={len(speakers)} lang={row['language']}"
          f" first_utt={row['utt_id']} speaker={row['speaker_id']} n_phones={n}"
          f" sample_speakers={speakers[:3]} text={row['text'][:60]!r}")
print("OK: all 5 datasets validated.")
PY
