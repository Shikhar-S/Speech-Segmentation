#!/bin/bash
#SBATCH -A bbjs-dtai-gh
#SBATCH -p ghx4-interactive
#SBATCH -J hf_upload
#SBATCH -N 1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=1
#SBATCH -c 16
#SBATCH --mem=32G
#SBATCH -t 1:00:00
#SBATCH -o exp/slurm_logs/%j.out
#SBATCH -e exp/slurm_logs/%j.out

set -euo pipefail

cd /work/nvme/bbjs/sbharadwaj/powsm/xeuspr
mkdir -p exp/slurm_logs

source ~/.bashrc
conda deactivate 2>/dev/null || true
source .venv_dai/bin/activate

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

python <<'PY'
from huggingface_hub import HfApi, DatasetCard, DatasetCardData

REPO_ID = "changelinglab/thchs30-segment"
FOLDER  = "exp/downloads/thchs30-seg"

api = HfApi()
print(f"Creating dataset repo {REPO_ID} (exist_ok=True)...")
api.create_repo(repo_id=REPO_ID, repo_type="dataset",
                exist_ok=True, private=False)

card_data = DatasetCardData(license="apache-2.0",
                             language=["zh"],
                             pretty_name="THCHS-30 segmentation")
card = DatasetCard.from_template(
    card_data,
    template_path=None,
    pretty_name="THCHS-30 segmentation",
)
card.push_to_hub(REPO_ID, repo_type="dataset")
print("License/card pushed.")

print(f"Uploading {FOLDER} -> {REPO_ID} ...")
api.upload_large_folder(
    repo_id=REPO_ID,
    repo_type="dataset",
    folder_path=FOLDER,
)
print("Upload complete.")
PY
